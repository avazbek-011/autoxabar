# ============================================================
#  AutoXabar / VIPADSUZ  —  konfiguratsiya
#  Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring
# ============================================================

# --- Umumiy ---
SECRET_KEY=            # MAJBURIY: python -c "import secrets;print(secrets.token_urlsafe(48))"
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
BASE_URL=http://127.0.0.1:5000
TIMEZONE=Asia/Tashkent

# Ilova oldida nechta ishonchli reverse-proxy bor (nginx, Render...).
# 0 = to'g'ridan-to'g'ri ochilgan. docker compose buni o'zi 1 qiladi.
# 0 bo'lmagan qiymat X-Forwarded-* sarlavhalariga ishonishni bildiradi —
# proksi yo'q bo'lsa 0 qoldiring, aks holda IP soxtalashtirilishi mumkin.
TRUSTED_PROXIES=0

# nginx portlari (docker compose uchun). 80 band bo'lsa o'zgartiring.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
RUN_SCHEDULER=1          # fon vazifalari shu jarayonda ishlasinmi

# --- Birinchi admin (avtomatik yaratiladi) ---
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=            # MAJBURIY: uzun parol kiriting
ADMIN_NAME=Administrator

# --- Narxlar (so'mda) ---
PRICE_PER_PROFILE=5000          # 1 profil / 1 oy
TRIAL_DAYS=3                    # yangi profil uchun bepul sinov kunlari

# --- Moliya ---
TAX_PERCENT=10                  # soliq foizi (foydadan)
ACQUIRING_PERCENT=1.0           # to'lov tizimi ekvayring komissiyasi (%)

# --- Click SHOP API (to'lovni qabul qilish) ---
# Click merchant kabinetidan olinadi. Servis sozlamalarida ikkita manzil:
#   Prepare URL  : https://<domen>/api/click/prepare
#   Complete URL : https://<domen>/api/click/complete
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# --- Payme Merchant API (hozircha ishlatilmaydi) ---
PAYME_MERCHANT_ID=
PAYME_KEY=                      # kassa kaliti (Merchant API parol)
PAYME_TEST_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# --- Payme Subscribe API (avto-to'lov, karta tokeni) ---
PAYME_SUBSCRIBE_URL=https://checkout.paycom.uz/api
PAYME_SUBSCRIBE_ID=             # Subscribe kassa ID
PAYME_SUBSCRIBE_KEY=            # Subscribe kassa kaliti

# --- Telegram (Telethon) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ENGINE=auto            # auto | real | demo

# --- Telegram bildirishnoma boti (ixtiyoriy) ---
NOTIFY_BOT_TOKEN=
NOTIFY_ADMIN_CHAT_ID=
