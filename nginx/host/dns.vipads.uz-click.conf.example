# ============================================================
#  SERVERNING O'Z nginx'i uchun — Click webhook: dns.vipads.uz
#
#  dns.vipads.uz uchun server bloki allaqachon mavjud, shuning uchun
#  bu yerda butun blok emas, faqat qo'shiladigan `location` berilgan.
#
#  Uni /etc/nginx/sites-available/ dagi dns.vipads.uz server blokining
#  ICHIGA qo'ying, so'ng:
#      nginx -t && systemctl reload nginx
#
#  ── DIQQAT: hozirgi holat ───────────────────────────────────
#
#  Tekshirganda bu yo'l allaqachon javob berdi:
#      GET  /api/payments/click/webhook  ->  405 Method Not Allowed
#      POST /api/payments/click/webhook  ->  403 Forbidden  (nginx sahifasi)
#
#  Ya'ni bu yo'l uchun allaqachon biror qoida bor — ehtimol IP
#  allowlist yoki `limit_except`. Yangi blokni qo'shishdan oldin
#  eskisini toping va olib tashlang, aks holda ikkitasi to'qnashadi:
#
#      grep -rn "payments/click" /etc/nginx/
#
#  Agar 403 ni Click IP lari uchun allowlist bersa — uni saqlang,
#  lekin Click'ning joriy IP lari ro'yxatini Click qo'llab-quvvatlash
#  xizmatidan oling. Aks holda haqiqiy to'lov so'rovlari ham rad
#  etiladi va to'lovlar Click tomonda "qo'lda tekshiruv"ga tushadi.
#
#  Xavfsizlik allowlist'ga bog'liq emas: har bir so'rov `sign_string`
#  (MD5 + maxfiy kalit) bilan tekshiriladi. Allowlist qo'shimcha
#  qatlam, majburiy emas.
# ============================================================

    # Ilova ichidagi yo'l ham aynan shunday, shuning uchun qayta
    # yozish (rewrite) kerak emas.
    location = /api/payments/click/webhook {
        # Click faqat POST yuboradi
        limit_except POST { deny all; }

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Click uzoq kutmasligi kerak: javob kechiksa to'lov
        # qo'lda tekshiruvga tushadi.
        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        # Javob JSON — nginx uni o'zgartirmasin
        proxy_buffering off;
    }

# ============================================================
#  Ulangandan keyin tekshirish
#
#  1) Yo'l ochiqmi (imzo noto'g'ri bo'lgani uchun -1 kutiladi,
#     lekin JSON kelishi kerak — 403/404/502 emas):
#
#     curl -s -X POST https://dns.vipads.uz/api/payments/click/webhook \
#       -d "click_trans_id=1&service_id=<SERVICE_ID>&merchant_trans_id=1" \
#       -d "amount=1.00&action=0&sign_time=2026-01-01 00:00:00" \
#       -d "sign_string=00000000000000000000000000000000"
#
#     Kutilgan javob:
#     {"click_trans_id":1,"error":-1,"error_note":"SIGN CHECK FAILED!",...}
#
#     Agar {"error":-8,...} kelsa — ilovada CLICK_SECRET_KEY sozlanmagan.
#
#  2) Click kabinetida Prepare URL va Complete URL maydonlarining
#     IKKALASIGA ham shu manzilni yozing:
#
#     https://dns.vipads.uz/api/payments/click/webhook
# ============================================================
